{
  "name": "demo-docus",
  "private": true,
  "version": "1.36.0",
  "type": "module",
  "scripts": {
    "copies": "gqlmd graphql-to-doc:markdown && node -e \"require('node:fs').cpSync('.markdown-copies', 'public', { recursive: true })\"",
    "dev": "npm run copies && nuxt dev",
    "build": "npm run copies && nuxt build",
    "generate": "npm run copies && nuxt generate",
    "preview": "npx serve .output/public",
    "doc": "gqlmd graphql-to-doc",
    "gqlmd": "gqlmd",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@graphql-markdown/cli": "^1.3.0",
    "@graphql-markdown/formatters": "^1.3.0",
    "@graphql-markdown/graphql": "^1.4.0",
    "@graphql-markdown/printer-legacy": "^1.21.0",
    "@graphql-tools/url-loader": "^10.0.9",
    "better-sqlite3": "^12.11.1",
    "docus": "^5.15.0",
    "graphql": "^17.1.0",
    "nuxt": "^4.6.4"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.10.2",
    "@playwright/test": "^1.65.1",
    "serve": "^14.2.8"
  }
}
